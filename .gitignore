__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
.venv/
build/
dist/

# Everything a run produces. Receipts and statements are the most sensitive
# documents this will ever touch and none of them belong in a repository.
inbox/
*.sqlite
*.sqlite3
*.db
.env

# What a run produces about the person running it. `decisions.jsonl` holds
# merchant names, dates and amounts; `receipts/` holds the documents
# themselves. Ignored as globs rather than by name, because listing files one
# by one is how a portfolio history shipped to PyPI in the sister project.
*.jsonl
receipts/
statements/
